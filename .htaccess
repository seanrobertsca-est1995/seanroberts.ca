# --------------------------------------------------
# Enable Rewrite Engine
# --------------------------------------------------
RewriteEngine On

# --------------------------------------------------
# FORCE HTTPS (Recommended for SEO)
# --------------------------------------------------
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# --------------------------------------------------
# REMOVE .php EXTENSION FROM URL (External Redirect)
# Example: /page.php → /page/
# --------------------------------------------------
RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[\s?] [NC]
RewriteRule ^ %1/ [R=301,L]

# --------------------------------------------------
# FORCE TRAILING SLASH (SEO consistency)
# Example: /page → /page/
# --------------------------------------------------
RewriteCond %{REQUEST_URI} !/$
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ /$1/ [R=301,L]

# --------------------------------------------------
# INTERNAL REWRITE (Clean URL → PHP file)
# Example: /page/ → /page.php
# --------------------------------------------------
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([^/]+)/$ $1.php [L]

# --------------------------------------------------
# PREVENT ACCESS TO PHP FILES DIRECTLY (OPTIONAL HARDENING)
# Uncomment if you want to force clean URLs only
# --------------------------------------------------
# RewriteCond %{THE_REQUEST} \.php [NC]
# RewriteRule ^ - [R=404,L]

# --------------------------------------------------
# DEFAULT INDEX HANDLING
# --------------------------------------------------
DirectoryIndex index.php index.html

# --------------------------------------------------
# CACHE CONTROL (Basic Performance Boost)
# --------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On

    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"

    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"

    ExpiresByType text/html "access plus 1 hour"
</IfModule>

# --------------------------------------------------
# GZIP COMPRESSION (If supported)
# --------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css application/javascript application/json
</IfModule>

# --------------------------------------------------
# SECURITY HEADERS (SAFE DEFAULTS)
# --------------------------------------------------
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
</IfModule>

# DO NOT REMOVE THIS LINE AND THE LINES BELOW ERRORPAGEID:0JtwyWgKle
ErrorDocument 404 https://seanroberts.ca/
ErrorDocument 403 https://seanroberts.ca/
# DO NOT REMOVE THIS LINE AND THE LINES ABOVE 0JtwyWgKle:ERRORPAGEID